DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 多模型互审（验证前事 / 后事分析）：审稿默认 Gemini，初稿与裁决默认 DeepSeek
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# ANALYSIS_PRIMARY=deepseek
# ANALYSIS_REVIEWER=gemini
# ANALYSIS_JUDGE=deepseek

# 设为 1 时，在服务端终端打印完整互审 JSON（含 auditSummary、pipelineTrace），勿对用户开放
# LOG_MULTIMODEL_DETAIL=1

# 后台数据面板：请求头 x-admin-key 或 URL ?key= 与此值一致方可读统计
ADMIN_ANALYTICS_KEY=change_me_to_a_long_random_secret

# 管理员查看某会话互审内部数据（浏览器或 curl，勿给用户）：
# GET /api/admin/session-trace?sessionId=YOUR_SESSION_ID&key=ADMIN_ANALYTICS_KEY

# （可选）Vercel 上稳定保存占卦会话：在 https://console.upstash.com 创建 Redis，复制 REST URL 与 Token
# 配置后全站会话走 Redis，多实例/冷启动仍可追问；不设则本地用文件、Vercel 仅用内存+/tmp（不可靠）
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

